# ── Desarrollo local (.env) ───────────────────────────────────────────────────
# API de Anthropic — solo para dev local (en Vercel va sin VITE_, ver abajo)
VITE_ANTHROPIC_API_KEY=sk-ant-...

# Supabase (opcional en local — sin esto usa localStorage)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...


# ── Variables de entorno en Vercel (Project → Settings → Environment Variables) ─
# ANTHROPIC_API_KEY   = sk-ant-...          ← server-side, nunca expuesta
# VITE_SUPABASE_URL   = https://xxx...      ← pública (ok)
# VITE_SUPABASE_ANON_KEY = eyJhbGci...     ← pública (ok, es la anon key)
